DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=render_studio
DB_PASSWORD=render_studio_local
APP_HOST=localhost
APP_PORT=3100
MAIL_FROM=Render Studio <noreply@localhost>
SMTP_ADDRESS=127.0.0.1
SMTP_PORT=51025

# Conta interna inicial (o seed não altera uma conta já existente).
SEED_USER_NAME=Administrador
SEED_USER_EMAIL=admin@renderstudio.local
SEED_USER_PASSWORD=RenderStudio@2026!

# Pausa entre checkpoints do executor simulado (0 a 5 segundos).
SIMULATION_STEP_SECONDS=0.75

# Blender local: execução em background com Cycles/CPU, sem Redis.
BLENDER_BIN=/snap/bin/blender
BLENDER_THREADS=2
BLENDER_TIMEOUT_SECONDS=3600
# Quantidade de processos consumidores de rendering (um render por processo).
RENDER_WORKERS=1

# Sugestões de renderização por texto (somente servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

BLENDER_HIP_LIBRARY_PATH=
BLENDER_DEVICE=HIP
GEMINI_RENDER_ENABLED=false
GEMINI_IMAGE_MODEL=
BLENDER_RENDER_ENABLED=false
LOCAL_AI_ENABLED=true
DEFAULT_RENDER_ENGINE=comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_PIPELINE=flux2_klein
